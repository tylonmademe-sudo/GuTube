<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_update_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/update_sheet_drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_github_update_handle" />

    <!-- Centered 48dp Frosted Glass Circle Badge -->
    <FrameLayout
        android:id="@+id/update_sheet_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_glass_circle">

        <ImageView
            android:id="@+id/mobile_update_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mobile_update"
            app:tint="@color/mobile_color_on_surface" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/update_sheet_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/update_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="21sp"
            tools:text="Downloading update" />

        <TextView
            android:id="@+id/update_sheet_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:fontFamily="@font/roboto_medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="12.5sp"
            tools:text="GuTube 1.5 · 45.60 MB" />

    </LinearLayout>

    <!-- Download Progress Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/update_sheet_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:indicatorColor="@color/mobile_color_on_surface"
            app:trackColor="@color/gutube_glass_stroke"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/update_sheet_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Downloading... 1.9 MB of 34 MB"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Inner Frosted Glass Content Card -->
    <com.newtube.mobile.ui.update.MaxHeightScrollView
        android:id="@+id/update_sheet_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_card"
        android:fadingEdgeLength="20dp"
        android:overScrollMode="never"
        android:padding="16dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/update_sheet_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Check your connection and try again."
                tools:visibility="visible" />

            <!-- Release notes -->
            <LinearLayout
                android:id="@+id/update_sheet_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/update_sheet_release_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/roboto_medium"
                android:foreground="@null"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:text="@string/mobile_update_release_notes"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="13.5sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </com.newtube.mobile.ui.update.MaxHeightScrollView>

    <!-- Matching 50dp Pill Action Buttons -->
    <LinearLayout
        android:id="@+id/update_sheet_actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_sheet_secondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:fontFamily="@font/roboto_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="50dp"
            android:textAllCaps="false"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="15sp"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:cornerRadius="25dp"
            tools:text="Cancel"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_sheet_primary"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="50dp"
            android:textAllCaps="false"
            android:textColor="@color/mobile_color_background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/mobile_color_on_surface"
            app:cornerRadius="25dp"
            tools:text="Update now"
            tools:visibility="visible" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/update_sheet_dont_ask"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/roboto_regular"
        android:minHeight="40dp"
        android:text="@string/mobile_update_dont_ask"
        android:textAllCaps="false"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        app:backgroundTint="@null"
        app:rippleColor="#26FFFFFF" />

</LinearLayout>
