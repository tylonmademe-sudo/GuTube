<?xml version="1.0" encoding="utf-8"?>
<!--
  GUTUBE(frame-studio): Pro-level Advanced Screenshot Mode Overlay.
  1:1 visual match to the Liquid Glass optical HUD design system in C:\Users\tylon\Desktop\schreenshort.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:visibility="gone">

    <!-- Zero-UI Soft Camera Shutter Flash Effect -->
    <View
        android:id="@+id/frame_studio_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FFF8E7"
        android:visibility="gone" />

    <!-- Top Bar: Left Timecode Pill | Center Minimal Pill | Right Close Button -->
    <LinearLayout
        android:id="@+id/frame_studio_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Left Container: Tabular Timecode Glass Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/frame_studio_timestamp_pill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_frame_studio_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/frame_studio_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    tools:text="04:12.366" />

            </LinearLayout>

        </LinearLayout>

        <!-- Center Container: Minimal Translucent FRAME STUDIO Badge -->
        <LinearLayout
            android:id="@+id/frame_studio_badge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_frame_studio_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@null"
                android:src="@drawable/ic_player_screenshot"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/roboto_medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/frame_studio_title"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Right Container: Minimal Frosted Close Button -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">

            <ImageButton
                android:id="@+id/frame_studio_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_frame_studio_pill_btn"
                android:contentDescription="@string/close"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sheet_close"
                app:tint="#FFFFFF" />

        </FrameLayout>

    </LinearLayout>

    <!-- Floating Popovers Container (Stably positioned above dock with clean vertical gap) -->
    <FrameLayout
        android:id="@+id/frame_studio_popover_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="72dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 1. Step Selector Popover Menu -->
        <LinearLayout
            android:id="@+id/frame_studio_step_popover"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_frame_studio_popover"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <!-- Segmented Tabs: Frame | Second | Minute | Custom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@drawable/bg_frame_studio_tab_bar"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/frame_studio_tab_frame"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_frame_studio_chip_active"
                    android:gravity="center"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/frame_studio_tab_frame"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/frame_studio_tab_second"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/frame_studio_tab_second"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/frame_studio_tab_minute"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/frame_studio_tab_minute"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/frame_studio_tab_custom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/frame_studio_tab_custom"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Subtitle Info (e.g. Detected FPS) -->
            <TextView
                android:id="@+id/frame_studio_step_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#B3FFFFFF"
                android:textSize="10.5sp"
                tools:text="Detected: 60fps · 1F ≈ 16.6ms" />

            <!-- Frame Chips Row (1F, 2F, 5F, 10F) -->
            <LinearLayout
                android:id="@+id/frame_studio_chips_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/frame_chip_1f"
                    style="@style/FrameStudioChip"
                    android:text="1F" />

                <TextView
                    android:id="@+id/frame_chip_2f"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="8dp"
                    android:text="2F" />

                <TextView
                    android:id="@+id/frame_chip_5f"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="8dp"
                    android:text="5F" />

                <TextView
                    android:id="@+id/frame_chip_10f"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="8dp"
                    android:text="10F" />

            </LinearLayout>

            <!-- Second Chips Row (0.5s, 1s, 2s, 5s) -->
            <LinearLayout
                android:id="@+id/frame_studio_chips_second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/frame_chip_05s"
                    style="@style/FrameStudioChip"
                    android:text="0.5s" />

                <TextView
                    android:id="@+id/frame_chip_1s"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="8dp"
                    android:text="1s" />

                <TextView
                    android:id="@+id/frame_chip_2s"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="8dp"
                    android:text="2s" />

                <TextView
                    android:id="@+id/frame_chip_5s"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="8dp"
                    android:text="5s" />

            </LinearLayout>

            <!-- Minute Chips Row (1m, 2m, 5m) -->
            <LinearLayout
                android:id="@+id/frame_studio_chips_minute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/frame_chip_1m"
                    style="@style/FrameStudioChip"
                    android:text="1m" />

                <TextView
                    android:id="@+id/frame_chip_2m"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="10dp"
                    android:text="2m" />

                <TextView
                    android:id="@+id/frame_chip_5m"
                    style="@style/FrameStudioChip"
                    android:layout_marginStart="10dp"
                    android:text="5m" />

            </LinearLayout>

            <!-- Custom Input Row -->
            <LinearLayout
                android:id="@+id/frame_studio_custom_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/frame_studio_custom_input"
                    android:layout_width="52dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_frame_studio_chip_inactive"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/frame_studio_custom_unit"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_frame_studio_chip_inactive" />

                <Button
                    android:id="@+id/frame_studio_custom_apply"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_frame_studio_pill_btn"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/frame_studio_apply"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- 2. Resolution Selector Popover Menu (Compact 2-Column Grid positioned above Quality button) -->
        <LinearLayout
            android:id="@+id/frame_studio_res_popover"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_frame_studio_popover"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:paddingHorizontal="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="RESOLUTION"
                android:textColor="#B3FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Container for 2-Column Resolution Option Items -->
            <LinearLayout
                android:id="@+id/frame_studio_res_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Floating Dock (Centered Glass Dock) -->
    <!-- [ ◀ ]  [ 2 Frames ▾ ]  [ ▶ ]  |  [ 1080p ▾ ]  [ 📸 Save ] -->
    <LinearLayout
        android:id="@+id/frame_studio_dock"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_frame_studio_dock"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <!-- Step Backward Button (◀) -->
        <ImageButton
            android:id="@+id/frame_studio_step_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_frame_studio_pill_btn"
            android:contentDescription="Previous step"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_frame_studio_prev"
            app:tint="#FFFFFF" />

        <!-- Step Interval Dropdown Selector: [ 2 Frames ▾ ] -->
        <LinearLayout
            android:id="@+id/frame_studio_step_selector"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_frame_studio_pill_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="80dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/frame_studio_step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="2 Frames" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_frame_studio_chevron_down"
                app:tint="#B3FFFFFF" />

        </LinearLayout>

        <!-- Step Forward Button (▶) -->
        <ImageButton
            android:id="@+id/frame_studio_step_forward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_frame_studio_pill_btn"
            android:contentDescription="Next step"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_frame_studio_next"
            app:tint="#FFFFFF" />

        <!-- Subtle Vertical Glass Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="4dp"
            android:background="#33FFFFFF" />

        <!-- Resolution Selector: [ 1080p ▾ ] -->
        <LinearLayout
            android:id="@+id/frame_studio_res_selector"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_frame_studio_pill_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/frame_studio_res_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="1080p" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_frame_studio_chevron_down"
                app:tint="#B3FFFFFF" />

        </LinearLayout>

        <!-- Standout Capturing Save Frame Button: [ 📸 Save ] -->
        <LinearLayout
            android:id="@+id/frame_studio_save_btn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_frame_studio_save_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/frame_studio_save_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_player_screenshot"
                android:tint="#111111"
                app:tint="#111111" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/frame_studio_save"
                android:textColor="#111111"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom-Left Post-Capture Notification Toast (Floating cleanly above bottom dock) -->
    <LinearLayout
        android:id="@+id/frame_studio_saved_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_frame_studio_card"
        android:clickable="true"
        android:elevation="14dp"
        android:focusable="true"
        android:minWidth="290dp"
        android:maxWidth="340dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Top Row: Thumbnail + Title & Metadata + Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Captured Frame Thumbnail with Quality Badge -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="35dp"
                android:background="#26FFFFFF">

                <ImageView
                    android:id="@+id/frame_studio_saved_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Screenshot thumbnail"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/frame_studio_saved_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="2dp"
                    android:background="#99000000"
                    android:fontFamily="@font/roboto_medium"
                    android:fontFeatureSettings="tnum"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="1dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    tools:text="1080p" />

            </FrameLayout>

            <!-- Title & Metadata -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/frame_studio_saved_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:includeFontPadding="false"
                    android:text="Frame Captured"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/frame_studio_saved_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10.5sp"
                    tools:text="04:12.450 • 1080p PNG" />

            </LinearLayout>

            <!-- Dismiss Cross Button -->
            <ImageButton
                android:id="@+id/frame_studio_saved_dismiss"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sheet_close"
                app:tint="#80FFFFFF" />

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:background="#1AFFFFFF" />

        <!-- Quick Actions Row: View in Library + Export / Share -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Gallery Button -->
            <LinearLayout
                android:id="@+id/frame_studio_saved_gallery"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/bg_frame_studio_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_frame_studio_gallery"
                    app:tint="#E6FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/roboto_medium"
                    android:includeFontPadding="false"
                    android:text="Library"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Share Button -->
            <LinearLayout
                android:id="@+id/frame_studio_saved_share"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_frame_studio_chip_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
