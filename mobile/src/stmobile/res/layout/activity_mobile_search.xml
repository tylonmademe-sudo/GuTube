<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch Search screen - Official YouTube Layout.
  - Top Bar (mobile_search_toolbar): Sleek 52dp bar with solid #0F0F0F background, back arrow, search pill, mic, filter button.
  - Results / Suggestions / Skeletons: Positioned directly below the top bar (layout_marginTop="52dp") with zero overlap.
  - Docked Bottom Nav Bar: Preserved at the bottom.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/mobile_color_background">

    <com.newtube.mobile.ui.common.GlassSource
        android:id="@+id/mobile_search_glass_source"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@color/mobile_color_background">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Search Results Grid: Starts right below the 52dp toolbar, zero overlap with cards -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mobile_search_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="52dp"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingHorizontal="@dimen/mobile_card_spacing"
                android:paddingBottom="@dimen/gutube_nav_clearance"
                android:scrollbars="none"
                tools:listitem="@layout/item_video_card" />

            <!-- Feed skeleton shimmer overlay -->
            <include
                layout="@layout/mobile_feed_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="52dp"
                android:visibility="gone" />

            <!-- Empty / error message -->
            <include
                android:id="@+id/mobile_search_message"
                layout="@layout/mobile_page_load_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="52dp" />

            <!-- No Internet Connection Overlay with Lottie animation -->
            <include
                layout="@layout/layout_no_internet_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="52dp" />

        </FrameLayout>

    </com.newtube.mobile.ui.common.GlassSource>

    <!-- Suggestions/history: full-height overlay below toolbar while editing query -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_search_suggestions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="52dp"
        android:background="@color/mobile_color_background"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:outlineProvider="none"
        android:paddingBottom="@dimen/gutube_nav_clearance"
        android:scrollbars="none"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_mobile_search_suggestion" />

    <!-- Top Bar: Sleek, compact YouTube Search Toolbar (52dp) -->
    <LinearLayout
        android:id="@+id/mobile_search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="@color/mobile_color_background"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <!-- Left: Back Arrow (24dp icon inside 40dp touch target) -->
        <ImageButton
            android:id="@+id/mobile_search_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="8dp"
            android:src="@drawable/ic_mobile_back_arrow"
            android:tint="#F5F5F5" />

        <!-- Center: Slim rounded search input pill (height 38dp, 19dp corner radius, #212121 fill) -->
        <LinearLayout
            android:id="@+id/mobile_search_pill"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_mobile_search_input_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/mobile_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/mobile_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:textCursorDrawable="@drawable/gutube_search_cursor"
                android:textSize="15sp" />

            <!-- Clear button (inline ✕ inside search pill) -->
            <ImageButton
                android:id="@+id/mobile_search_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_search_clear"
                android:padding="6dp"
                android:src="@drawable/ic_sheet_close"
                android:tint="#CCCCCC"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Right: Compact Mic (22dp icon inside 38dp touch target) -->
        <ImageButton
            android:id="@+id/mobile_search_mic"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_voice"
            android:padding="8dp"
            android:src="@drawable/ic_mobile_mic"
            android:tint="#F5F5F5" />

        <!-- Right: Filter / Options button (22dp icon inside 38dp touch target, clean 8dp gap) -->
        <ImageButton
            android:id="@+id/mobile_search_filters"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_filters"
            android:padding="8dp"
            android:src="@drawable/ic_mobile_tune"
            android:tint="#F5F5F5" />

    </LinearLayout>

    <!-- Floating Liquid Glass nav pill over the results, Search lit -->
    <com.newtube.mobile.ui.common.GlassView
        android:id="@+id/mobile_nav_glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="?attr/gutubeNavSideMargin"
        android:layout_marginBottom="?attr/gutubeNavBottomMargin"
        android:elevation="16dp"
        android:padding="6dp"
        android:visibility="gone"
        app:glassCornerRadius="?attr/gutubeNavCorner"
        app:glassMaxWidth="?attr/gutubeNavMaxWidth"
        app:glassLiquid="?attr/gutubeNavLiquid"
        app:glassTint="?attr/gutubeNavTint"
        app:glassStrokeColor="?attr/gutubeNavStrokeColor"
        app:glassStrokeWidth="?attr/gutubeNavStrokeWidth">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/mobile_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemBackground="@android:color/transparent"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/mobile_bottom_nav_item"
            app:itemRippleColor="@android:color/transparent"
            app:itemTextAppearanceActive="@style/MobileBottomNavText"
            app:itemTextAppearanceActiveBoldEnabled="false"
            app:itemTextAppearanceInactive="@style/MobileBottomNavText"
            app:itemTextColor="@color/mobile_bottom_nav_item"
            app:labelVisibilityMode="labeled"
            app:paddingBottomSystemWindowInsets="false" />

    </com.newtube.mobile.ui.common.GlassView>

    <!-- Minimizing a video opened from these results keeps playback alive in this overlay. -->
    <include layout="@layout/mobile_mini_player_overlay" />

</FrameLayout>
