<?xml version="1.0" encoding="utf-8"?>
<!-- In-app GitHub update bottom sheet modal dialog (Liquid Glass Card) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_github_update_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_mobile_sheet_handle" />

    <!-- Card Header: App Icon + Title & Version -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp">

        <ImageView
            android:id="@+id/github_update_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@mipmap/app_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/github_update_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Available"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/github_update_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.75"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                tools:text="GuTube 3.5.0 · 34 MB" />

        </LinearLayout>

    </LinearLayout>

    <!-- Download Progress Bar & Live Text (Visible during download) -->
    <LinearLayout
        android:id="@+id/github_update_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/github_update_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#EF4444"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="3.5dp" />

        <TextView
            android:id="@+id/github_update_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            tools:text="1.9 MB of 34 MB" />

    </LinearLayout>

    <!-- Card Body (.card-body): What's New (.card-title) & Changelog (.card-description) - Single unified card -->
    <LinearLayout
        android:id="@+id/github_update_notes_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp">

        <TextView
            android:id="@+id/github_update_whats_new_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's new"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            tools:text="What's new in 3.5.0" />

        <com.newtube.mobile.ui.update.MaxHeightScrollView
            android:id="@+id/github_update_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fadingEdgeLength="16dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/github_update_notes_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </com.newtube.mobile.ui.update.MaxHeightScrollView>

    </LinearLayout>

    <!-- Action Buttons (.glass-button): Cancel and Update Now -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_update_btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_github_update_btn_cancel"
            android:paddingHorizontal="18dp"
            android:text="Not now"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="10dp"
            app:rippleColor="#26FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_update_btn_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:background="@drawable/bg_github_update_btn_action"
            android:paddingHorizontal="22dp"
            android:text="Update now"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="10dp"
            app:rippleColor="#33FFFFFF" />

    </LinearLayout>

</LinearLayout>
