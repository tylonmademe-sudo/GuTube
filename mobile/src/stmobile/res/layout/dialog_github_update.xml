<?xml version="1.0" encoding="utf-8"?>
<!-- In-app GitHub update bottom sheet modal dialog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_github_update_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_mobile_sheet_handle" />

    <!-- Header: App Icon, Title, Version Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp">

        <ImageView
            android:id="@+id/github_update_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/github_update_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Available"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/github_update_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_github_update_version_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                tools:text="Version 3.4.3 · 34 MB" />

        </LinearLayout>

    </LinearLayout>

    <!-- Download Progress Bar & Live Text (Visible during download) -->
    <LinearLayout
        android:id="@+id/github_update_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/github_update_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#818CF8"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/github_update_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            tools:text="1.9 MB of 34 MB" />

    </LinearLayout>

    <!-- What's New / Changelog Bullet Points -->
    <LinearLayout
        android:id="@+id/github_update_notes_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/github_update_whats_new_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's new"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <com.newtube.mobile.ui.update.MaxHeightScrollView
            android:id="@+id/github_update_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="24dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/github_update_notes_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </com.newtube.mobile.ui.update.MaxHeightScrollView>

    </LinearLayout>

    <!-- Action Buttons: Cancel and Update Now -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_update_btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_github_update_btn_cancel"
            app:backgroundTint="@null"
            android:paddingHorizontal="20dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:rippleColor="#26FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_update_btn_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:background="@drawable/bg_github_update_btn_action"
            app:backgroundTint="@null"
            android:paddingHorizontal="24dp"
            android:text="Update Now"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:rippleColor="#33000000" />

    </LinearLayout>

</LinearLayout>
