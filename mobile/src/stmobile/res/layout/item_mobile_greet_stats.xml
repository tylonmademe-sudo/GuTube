<?xml version="1.0" encoding="utf-8"?>
<!-- GUTUBE(stats): 3D perspective tilt glass card with particle starfield matching code.html tiltCard. -->
<com.newtube.mobile.ui.browse.TiltGlassCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tiltCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:elevation="12dp"
    app:glassCornerRadius="38dp"
    app:glassLiquid="true"
    app:glassOnGlass="true"
    app:glassStrokeColor="#26FFFFFF"
    app:glassStrokeWidth="1dp"
    app:glassTint="#47000000">

    <!-- Starry particle field canvas (locked inside the card) -->
    <com.newtube.mobile.ui.browse.StarfieldView
        android:id="@+id/starfieldCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground statistics content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <!-- Primary Usage Hero -->
        <TextView
            android:id="@+id/stats_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            tools:text="41m" />

        <TextView
            android:id="@+id/stats_hero_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/mobile_stats_hero_label"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            tools:text="in GuTube today" />

        <!-- 3-Column Metrics Row: Watched | Videos | Daily average -->
        <LinearLayout
            android:id="@+id/stats_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal" />

        <!-- Weekly Trend & Histogram -->
        <TextView
            android:id="@+id/stats_week_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Last 7 days · 54m" />

        <LinearLayout
            android:id="@+id/stats_bars"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/stats_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <!-- Footnotes -->
        <TextView
            android:id="@+id/stats_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            tools:text="Tap a bar to see that day" />

        <!-- Privacy Shield & Lock Note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_greet_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mobile_stats_on_device"
                android:textColor="#8CFFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</com.newtube.mobile.ui.browse.TiltGlassCard>
