<?xml version="1.0" encoding="utf-8"?>
<!-- GUTUBE(stats): 3D perspective tilt glass card with particle starfield matching code.html tiltCard. -->
<com.newtube.mobile.ui.browse.TiltGlassCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tiltCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:elevation="12dp"
    app:glassCornerRadius="28dp"
    app:glassLiquid="true"
    app:glassOnGlass="true"
    app:glassStrokeColor="@color/gutube_glass_stroke"
    app:glassStrokeWidth="1.2dp"
    app:glassTint="@color/gutube_greet_card_tint">

    <!-- Starry particle field canvas (locked inside the card) -->
    <com.newtube.mobile.ui.browse.StarfieldView
        android:id="@+id/starfieldCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <!-- Foreground statistics content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <!-- Primary Usage Hero -->
        <TextView
            android:id="@+id/stats_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="41m" />

        <TextView
            android:id="@+id/stats_hero_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/roboto"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/mobile_stats_hero_label"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            tools:text="Today\'s Screen Time" />

        <!-- 3-Column Metrics Row: Watched | Videos | Daily average -->
        <LinearLayout
            android:id="@+id/stats_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <!-- Weekly Trend & Histogram -->
        <TextView
            android:id="@+id/stats_week_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_medium"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Weekly Activity · 54m" />

        <LinearLayout
            android:id="@+id/stats_bars"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/stats_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal" />

    </LinearLayout>

</com.newtube.mobile.ui.browse.TiltGlassCard>
