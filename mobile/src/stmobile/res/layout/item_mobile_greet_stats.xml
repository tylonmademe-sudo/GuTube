<?xml version="1.0" encoding="utf-8"?>
<!-- GUTUBE(stats): 3D perspective tilt glass card with particle starfield matching code.html tiltCard. -->
<com.newtube.mobile.ui.browse.TiltGlassCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tiltCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:elevation="12dp"
    app:glassCornerRadius="28dp"
    app:glassLiquid="true"
    app:glassOnGlass="true"
    app:glassStrokeColor="#33FFFFFF"
    app:glassStrokeWidth="1.2dp"
    app:glassTint="#47000000">

    <!-- Starry particle field canvas (locked inside the card) -->
    <com.newtube.mobile.ui.browse.StarfieldView
        android:id="@+id/starfieldCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground statistics content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="22dp">

        <!-- Primary Usage Hero -->
        <TextView
            android:id="@+id/stats_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            tools:text="41m" />

        <TextView
            android:id="@+id/stats_hero_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/roboto"
            android:gravity="center"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/mobile_stats_hero_label"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            tools:text="Today\'s Screen Time" />

        <!-- 3-Column Metrics Row: Watched | Videos | Daily average -->
        <LinearLayout
            android:id="@+id/stats_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal" />

        <!-- Weekly Trend & Histogram -->
        <TextView
            android:id="@+id/stats_week_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/roboto_medium"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Weekly Activity · 54m" />

        <LinearLayout
            android:id="@+id/stats_bars"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/stats_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <!-- Footnotes -->
        <TextView
            android:id="@+id/stats_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto"
            android:gravity="center"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            tools:text="Tap a bar for details" />

        <!-- Privacy Shield Note (no lock icon) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:shadowColor="#33000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/mobile_stats_on_device"
                android:textColor="#8CFFFFFF"
                android:textSize="11.5sp" />

        </LinearLayout>

    </LinearLayout>

</com.newtube.mobile.ui.browse.TiltGlassCard>
