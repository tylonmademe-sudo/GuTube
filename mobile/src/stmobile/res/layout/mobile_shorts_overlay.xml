<?xml version="1.0" encoding="utf-8"?>
<!-- GUTUBE(shorts): the vertical player's overlay (ShortsOverlay), laid out like YouTube's Shorts:
     channel row (avatar, name, Subscribe), title and views bottom-left; like / dislike / comments /
     share bottom-right; a thin progress line at the very bottom; the play/pause flash and the
     double-tap heart in the middle. Text carries shadows over a light scrim; the buttons and the
     flash are frosted discs of the video (GUTUBE(glass), set in ShortsOverlay). The actions
     forward to the watch page's own buttons. The peek is the next (or previous) short's portrait
     thumbnail that follows a swipe in from the edge, outside this box (clipChildren off). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_shorts_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/mobile_shorts_peek"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- GUTUBE(shorts peek): the next short's real first frame (ShortsPeekPlayer), over the
         thumbnail. Always laid out (a TextureView only gets its surface by drawing), parked a
         screen below while unused; transparent until it holds a frame. -->
    <TextureView
        android:id="@+id/mobile_shorts_peek_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:alpha="0.6"
        android:background="@drawable/mobile_player_top_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/mobile_shorts_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mobile_shorts_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mobile_back_arrow"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/mobile_shorts_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/header_shorts"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mobile_shorts_download"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dialog_download"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_watch_download"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/mobile_shorts_mute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_shorts_mute"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_volume_up"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/mobile_shorts_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_search_button"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mobile_search"
                android:tint="@android:color/white" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:alpha="0.55"
        android:background="@drawable/mobile_player_bottom_scrim"
        android:importantForAccessibility="no" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/mobile_shorts_heart"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:importantForAccessibility="no"
        app:lottie_rawRes="@raw/liked"
        app:lottie_loop="false"
        app:lottie_autoPlay="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/mobile_shorts_flash"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_shorts_flash_circle"
        android:importantForAccessibility="no"
        android:padding="18dp"
        android:src="@drawable/ic_player_play"
        android:tint="@android:color/white" />

    <LinearLayout
        android:id="@+id/mobile_shorts_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mobile_shorts_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_shorts_avatar"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/mobile_shorts_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_medium"
                android:maxLines="1"
                android:maxWidth="160dp"
                android:shadowColor="#B3000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="\@channel" />

            <TextView
                android:id="@+id/mobile_shorts_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_shorts_subscribe"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:text="@string/mobile_watch_subscribe"
                android:textColor="@color/mobile_shorts_subscribe_text"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/mobile_shorts_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="A short's title that may run onto a second line" />

        <TextView
            android:id="@+id/mobile_shorts_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            tools:text="1.2M views · 3 days ago" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/mobile_shorts_actions"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/mobile_shorts_like"
            style="@style/GuTubeShortsAction"
            android:contentDescription="@string/mobile_watch_like"
            android:src="@drawable/ic_watch_thumb_up_outline" />

        <TextView
            android:id="@+id/mobile_shorts_like_count"
            style="@style/GuTubeShortsActionLabel"
            android:text="@string/mobile_watch_like" />

        <ImageButton
            android:id="@+id/mobile_shorts_dislike"
            style="@style/GuTubeShortsAction"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/mobile_watch_dislike"
            android:src="@drawable/ic_watch_thumb_down_outline" />

        <TextView
            style="@style/GuTubeShortsActionLabel"
            android:text="@string/mobile_watch_dislike" />

        <ImageButton
            android:id="@+id/mobile_shorts_comments"
            style="@style/GuTubeShortsAction"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/mobile_comments_title"
            android:src="@drawable/ic_watch_comment" />

        <TextView
            android:id="@+id/mobile_shorts_comments_count"
            style="@style/GuTubeShortsActionLabel"
            android:text="@string/mobile_comments_title" />

        <ImageButton
            android:id="@+id/mobile_shorts_share"
            style="@style/GuTubeShortsAction"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/mobile_watch_share"
            android:src="@drawable/ic_shorts_share" />

        <TextView
            style="@style/GuTubeShortsActionLabel"
            android:text="@string/mobile_watch_share" />

        <ImageButton
            android:id="@+id/mobile_shorts_more"
            style="@style/GuTubeShortsAction"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/mobile_menu_more"
            android:src="@drawable/ic_mobile_more_vert" />

    </LinearLayout>

    <!-- The time while scrubbing, big, like YouTube's. -->
    <TextView
        android:id="@+id/mobile_shorts_seek_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:fontFamily="@font/roboto_medium"
        android:shadowColor="#B3000000"
        android:shadowRadius="6"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:visibility="gone"
        tools:text="0:12 / 0:45"
        tools:visibility="visible" />

    <!-- A thin line that scrubs: the thumb shows while a finger holds it, the seek lands on release. -->
    <view class="com.newtube.mobile.ui.common.GlowProgressBar$Seek"
        android:id="@+id/mobile_shorts_progress"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="bottom"
        android:background="@null"
        android:max="1000"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressDrawable="@drawable/gutube_shorts_seek"
        android:splitTrack="false"
        android:thumb="@drawable/gutube_shorts_seek_thumb"
        android:thumbOffset="0dp" />

    <!-- YouTube Authentic Unsubscribe Dialog / Bottom Sheet -->
    <FrameLayout
        android:id="@+id/mobile_shorts_unsubscribe_modal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- Backdrop scrim -->
        <View
            android:id="@+id/mobile_shorts_unsubscribe_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <!-- Bottom Sheet Card -->
        <LinearLayout
            android:id="@+id/mobile_shorts_unsubscribe_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_shorts_bottom_sheet"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/mobile_shorts_unsubscribe_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Unsubscribe from Febro Edits?" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto"
                android:lineSpacingExtra="3dp"
                android:text="@string/mobile_shorts_unsubscribe_body"
                android:textColor="#A3A3A3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mobile_shorts_unsubscribe_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/roboto_medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@android:string/cancel"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/mobile_shorts_unsubscribe_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/roboto_medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="@string/unsubscribe_from_channel"
                    android:textColor="#3EA6FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
