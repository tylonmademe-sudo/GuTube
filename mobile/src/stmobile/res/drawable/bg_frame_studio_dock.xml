<?xml version="1.0" encoding="utf-8"?>
<!--
  Frame Studio Liquid Glass Dock Container
  glass-surface-panel: rgba(30, 41, 59, 0.22) frosted base + 1px rgba(255, 255, 255, 0.15) specular border
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent deep frosted glass base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#33243346"
                android:centerColor="#261E293B"
                android:endColor="#1F16202C" />
        </shape>
    </item>
    <!-- Crisp 1px specular white border (rgba(255, 255, 255, 0.16)) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <!-- Top specular lens reflection highlight -->
    <item
        android:top="1dp"
        android:left="16dp"
        android:right="16dp"
        android:bottom="22dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="999dp" android:topRightRadius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
