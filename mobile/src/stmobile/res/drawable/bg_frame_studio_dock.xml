<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/gutube_frame_dock_fill_start"
                android:centerColor="@color/gutube_frame_dock_fill_center"
                android:endColor="@color/gutube_frame_dock_fill_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="@color/gutube_glass_rim" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="16dp"
        android:right="16dp"
        android:bottom="22dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="999dp" android:topRightRadius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/gutube_player_glass_sheen"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
