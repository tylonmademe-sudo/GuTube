<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/gutube_player_glass_underlay" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/gutube_player_glass_fill_start"
                        android:centerColor="@color/gutube_player_glass_fill_center"
                        android:endColor="@color/gutube_player_glass_fill_end" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="1dp"
                        android:color="@color/gutube_player_glass_rim" />
                </shape>
            </item>
            <item
                android:top="1dp"
                android:left="6dp"
                android:right="6dp"
                android:bottom="22dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/gutube_player_glass_sheen"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
