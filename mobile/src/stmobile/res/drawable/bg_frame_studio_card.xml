<?xml version="1.0" encoding="utf-8"?>
<!--
  Frame Studio Post-Capture Notification Toast Card
  glass-notification-toast: rgba(30, 41, 59, 0.25) base + 1px rgba(255, 255, 255, 0.15) border
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#4D243346"
                android:centerColor="#401E293B"
                android:endColor="#3316202C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="14dp"
        android:right="14dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="19dp" android:topRightRadius="19dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
