<?xml version="1.0" encoding="utf-8"?>
<!--
  Frame Studio Pill Badge Background
  glass-surface-panel: rgba(30, 41, 59, 0.22) with 1px rgba(255, 255, 255, 0.15) border
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#33243346"
                android:centerColor="#261E293B"
                android:endColor="#1F16202C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
