<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass Pill Button Background
  rgba(255, 255, 255, 0.08) - rgba(255, 255, 255, 0.15) frosted glass gradient
  + 1px rgba(255, 255, 255, 0.22) specular rim
  + inner top specular sheen reflection
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <!-- 1. Ambient Glass Dark Tint Underlayer -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="#26000000" />
                </shape>
            </item>
            <!-- 2. Frosted Liquid Glass Gradient Body -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:centerColor="#1AFFFFFF"
                        android:endColor="#12FFFFFF" />
                </shape>
            </item>
            <!-- 3. Specular Border Rim -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#38FFFFFF" />
                </shape>
            </item>
            <!-- 4. Top Inner Specular Reflection -->
            <item
                android:top="1dp"
                android:left="10dp"
                android:right="10dp"
                android:bottom="20dp">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="999dp" android:topRightRadius="999dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
