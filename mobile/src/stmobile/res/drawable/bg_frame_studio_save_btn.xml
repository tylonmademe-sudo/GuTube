<?xml version="1.0" encoding="utf-8"?>
<!--
  Frame Studio Standout Save Frame Button
  Luminous solid white camera pill trigger per new design specification & screen.png
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:endColor="#F0F2F5" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#E6FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
