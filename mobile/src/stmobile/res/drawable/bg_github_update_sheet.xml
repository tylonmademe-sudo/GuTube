<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Stitch Glassmorphism Card Sheet:
  - 34dp top corner radius (rounded-t-[34px])
  - Bottom edge is completely seamless with ZERO stroke line (android:bottom="-4dp")
  - Translucent obsidian glass surface (#F2212226 to #FC17181C)
  - 1px border stroke: 1px solid rgba(255, 255, 255, 0.20)
  - Inset specular rim highlight: rgba(255, 255, 255, 0.15) fading out
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass surface: bottom="-4dp" clips out bottom border stroke completely -->
    <item android:bottom="-4dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="34dp"
                android:topRightRadius="34dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#F2212226"
                android:centerColor="#F71C1D21"
                android:endColor="#FC17181C"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- Inset Specular Rim Highlight -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="80dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="33dp"
                android:topRightRadius="33dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
