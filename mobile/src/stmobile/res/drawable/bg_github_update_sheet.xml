<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub Releases in-app updater glassmorphism card background.
  Slate-tinted translucent dark glass with subtle indigo ambient glow and 1dp border.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Slate glass surface with vertical gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="36dp"
                android:topRightRadius="36dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#F01E283C"
                android:centerColor="#F5151B27"
                android:endColor="#FA0F131C"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
    <!-- Soft top inner ambient edge highlight -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="80dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="35dp"
                android:topRightRadius="35dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
