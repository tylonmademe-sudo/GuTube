<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass In-App Update Sheet:
  - 28dp corner radius (rounded-t-[28px])
  - Crystal-clear true glass fill: rgba(255, 255, 255, 0.04) to rgba(255, 255, 255, 0.08) (zero opaque grey)
  - Replicates box-shadow: inset 0 0 6px -3px rgba(255, 255, 255, 0.7) using crisp 1.5dp specular border
  - Replicates box-shadow: 0px 0px 21px -8px rgba(255, 255, 255, 0.3) with ambient soft white outer glow rim
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ambient soft white elevation glow (0px 0px 21px -8px rgba(255, 255, 255, 0.3)) -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
            <stroke
                android:width="2dp"
                android:color="@color/gutube_glass_sheen" />
        </shape>
    </item>

    <!-- Main crystal-clear liquid glass base surface -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="27dp"
                android:topRightRadius="27dp"
                android:bottomLeftRadius="27dp"
                android:bottomRightRadius="27dp" />
            <solid android:color="@color/gutube_sheet_glass" />
            <stroke
                android:width="1.5dp"
                android:color="@color/gutube_glass_rim" />
        </shape>
    </item>

    <!-- Inner Specular Rim Highlight -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="48dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/gutube_glass_sheen"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
